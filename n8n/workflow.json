    {
      "parameters": {
        "jsCode": "const itens = $input.first().json.ordens;\nconst porComponente = {};\nlet soma = 0;\n\nfor (const o of itens) {\n  const p = Number(o.qtd_pendente_calc);\n  soma += p;\n  porComponente[o.componente] = (porComponente[o.componente] || 0) + p;\n}\n\nconst top5 = Object.entries(porComponente)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5)\n  .map(([c, v]) => `${c} (${v})`)\n  .join('; ');\n\nreturn [{\n  json: {\n    data_execucao: new Date().toLocaleString('sv-SE', { timeZone: 'America/Sao_Paulo' }),\n    ferramenta: 'N8N',\n    total_pendentes: itens.length,\n    soma_pendente: soma,\n    top5_componentes: top5,\n    link_dashboard: 'https://prodigyb0y.github.io/alerta-desvio-consumo/'\n  }\n}];"
      },
